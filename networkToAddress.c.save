#include <stdio.h>
#include <arpa/inet.h>
#include <string.h>

int main()
{
struct sockaddr_in address1, address2;
char _first[255];

//hex should be sent always in big Endian form
address1.sin_addr.s_addr=htonl(0xffffffff);
address2.sin_addr.s_addr=htonl(0x00000000);

char *first=inet_ntoa(address1.sin_addr);
strcpy(_first, first);

// first and second point to same buffer , so buffer changes in second call
char* second=inet_ntoa(address2.sin_addr);

printf("address:%s\n", _first);
printf("address:%s\n",second);


return 0;
}
